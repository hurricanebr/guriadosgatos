{
  "buildCommand": "sh build.sh",
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/cat-sitter-ou-hotel-para-gatos",
      "destination": "/cat-sitting-ou-hotel-para-gatos",
      "permanent": true
    },
    {
      "source": "/cat-sitter-ou-hotel-para-gatos.html",
      "destination": "/cat-sitting-ou-hotel-para-gatos",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(css|js|webp|png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
